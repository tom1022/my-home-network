apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-server
  namespace: argocd
  annotations:
    # Traefik-specific annotations
    traefik.ingress.kubernetes.io/router.entrypoints: web
    # Disable HTTPS redirect since SSL is terminated at VPS Nginx
    traefik.ingress.kubernetes.io/router.middlewares: argocd-redirect-http@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
  - host: argocd.fickledev.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: argocd-server
            port:
              number: 80
---
# Middleware to handle gRPC Web (used by ArgoCD UI)
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: argocd-headers
  namespace: argocd
spec:
  headers:
    customRequestHeaders:
      X-Forwarded-Proto: "https"
