/ansible/collections/*
!/ansible/collections/requirements.yml

*.retry

.env

# ansible-vault encrypted secrets; supply values via Infisical instead
ansible/inventory/**/*vault.yml

.vscode/

terraform/.discovery/

# reference only; not consumed by any tool, see file header
terraform/.env.example

