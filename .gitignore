.terraform/

*.tfvars
*.tfvars.json
# non-secret defaults, tracked intentionally; see terraform/terraform.tfvars header
!/terraform/terraform.tfvars

*.tfstate
*.tfstate.*
tfplan.*

crash.log
crash.*.log

*.log

*.pyc
*.pyo
