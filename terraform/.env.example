# このファイルはローカルでは使用しません。Terraform 用シークレットの供給元は Infisical です。
# 以下はキー名のリファレンス（同じ名前で Infisical prod 環境に格納する）であり、
# 実行時は `.env` に書き出さず、次のように infisical run で子プロセスへ注入します。
#
#   set -a; source ~/.config/infisical/universal-auth.env; set +a
#   INFTOK=$(infisical login --method=universal-auth \
#     --client-id="$INFISICAL_UNIVERSAL_AUTH_CLIENT_ID" \
#     --client-secret="$INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET" \
#     --plain --silent)
#   infisical run --token="$INFTOK" --projectId=<project-id> --env=prod -- terraform plan
#
# Proxmox 認証はパスワードではなく API トークンを使う（proxmox_auth_method のデフォルトは "token"）。
TF_VAR_proxmox_api_url="https://192.168.1.2:8006/api2/json/"
TF_VAR_proxmox_auth_method="token"
TF_VAR_proxmox_api_token_id="terraform@pve!terraform"
TF_VAR_proxmox_api_token_secret="__CHANGE_ME__"

TF_VAR_ssh_public_key="ssh-ed25519 __CHANGE_ME__"
