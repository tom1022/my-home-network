*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
COMMIT

# nginx/haproxy proxy every connection in userspace (SNI/TCP passthrough is
# an application-layer proxy, not kernel routing) and need neither NAT nor
# forwarding, so this table defines no MASQUERADE rule and INPUT denies by
# default. xrayvpn's VPN egress is the one thing that ever forwarded
# through this host (POSTROUTING -o {{ vps_external_interface | default('eth0') }} -j MASQUERADE, plus
# net.ipv4.ip_forward=1 in tasks/main.yml): restore both together if
# xrayvpn (vps_proxy_xray_sni) is revived, or clients get no route out.
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
# Covers ntpd's udp/123 replies too: conntrack tracks UDP request/reply as a
# pseudo-connection, so a dedicated --dport 123 rule would be redundant.
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# tailnet membership (Tailscale ACL / node auth) is the access control here;
# once on tailscale0 a peer is trusted for every port. Written explicitly
# rather than relying on tailscaled's self-inserted `ts-input -i tailscale0
# -j ACCEPT`, so INPUT is still correct for the window before tailscaled
# (re)inserts its chain, e.g. early at boot.
-A INPUT -i tailscale0 -j ACCEPT
# A blanket ICMP block silently turns into TCP stalls on paths with a
# smaller MTU than this host's (PMTUD depends on ICMP getting through).
-A INPUT -p icmp -j ACCEPT
{% if vps_proxy_filter_ssh_public_allowed %}
-A INPUT -p tcp --dport 22 -j ACCEPT
{% endif %}
{% for port in vps_proxy_filter_allow_tcp_ports %}
-A INPUT -p tcp --dport {{ port }} -j ACCEPT
{% endfor %}
{% for port in vps_proxy_filter_allow_udp_ports %}
-A INPUT -p udp --dport {{ port }} -j ACCEPT
{% endfor %}
COMMIT
