# IPv6 mirror of iptables_rules.v4.j2's *filter table (same allow-list, same
# tailscale0 trust, same {{ vps_proxy_filter_chain }} indirection so that
# `iptables-restore --noflush` can re-apply it without touching dockerd's
# runtime chains or duplicating rules).
*filter
:INPUT DROP [0:0]
:{{ vps_proxy_filter_chain }} - [0:0]
-A {{ vps_proxy_filter_chain }} -i lo -j ACCEPT
-A {{ vps_proxy_filter_chain }} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A {{ vps_proxy_filter_chain }} -i tailscale0 -j ACCEPT
# Unlike ICMPv4, ICMPv6 is not optional: Neighbor Discovery and Router
# Advertisement (address resolution, autoconf) ride on it, so blocking it
# breaks IPv6 networking itself, not just diagnostics.
-A {{ vps_proxy_filter_chain }} -p ipv6-icmp -j ACCEPT
{% if vps_proxy_filter_ssh_public_allowed %}
-A {{ vps_proxy_filter_chain }} -p tcp --dport 22 -j ACCEPT
{% endif %}
{% for port in vps_proxy_filter_allow_tcp_ports %}
-A {{ vps_proxy_filter_chain }} -p tcp --dport {{ port }} -j ACCEPT
{% endfor %}
{% for port in vps_proxy_filter_allow_udp_ports %}
-A {{ vps_proxy_filter_chain }} -p udp --dport {{ port }} -j ACCEPT
{% endfor %}
-A INPUT -j {{ vps_proxy_filter_chain }}
COMMIT
