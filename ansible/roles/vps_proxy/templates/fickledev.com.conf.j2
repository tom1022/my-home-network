server {
    listen 80;
    server_name *.{{ vps_proxy_domain_main }};

    return 403;
}

server {
    listen 127.0.0.1:8443 ssl http2;
    server_name *.{{ vps_proxy_domain_main }};

    # Reached directly by scans hitting the IP with a forged SNI, bypassing
    # Cloudflare's proxy entirely, so this catch-all needs a publicly-trusted
    # certificate rather than one only Cloudflare's edge would trust.
    ssl_certificate {{ vps_proxy_acme_live_dir }}/fullchain.pem;
    ssl_certificate_key {{ vps_proxy_acme_live_dir }}/privkey.pem;

    return 403;
}
