---
# console_proxy_targets と web_terminal_targets (group_vars/console/main.yml が
# 唯一の正) から生成する。リンクの一覧をここへ手書きしない。
title: "Console"
subtitle: "console-pi"
header: true
footer: false
theme: default

services:
  - name: "Cloudflare 経由"
    icon: "fas fa-cloud"
    items:
{% for target in (console_proxy_targets + web_terminal_targets) %}
      - name: "{{ target.public_hostname }}"
        subtitle: "{{ target.description }}"
        url: "https://{{ target.public_hostname }}.{{ landing_page_domain }}/"
{% endfor %}
