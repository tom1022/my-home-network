# Managed by Ansible role kanidm_unixd. Local edits will be overwritten.
#
# kanidm-unixd ships this fragment pre-installed at
# /etc/ssh/sshd_config.d/10-kanidm.conf with everything commented out; this
# template just enables it. sshd honours only the first
# AuthorizedKeysCommand directive it reads, and Include (near the top of
# /etc/ssh/sshd_config) is processed before the rest of the file, so the
# "10-" prefix must sort before any other drop-in (e.g. systemd-userdbd's
# 20-systemd-userdb.conf) that would otherwise claim this directive first.
# This is additive to (not a replacement for) ~/.ssh/authorized_keys: sshd
# tries both sources and accepts either, so existing local accounts
# (tochi/debian) are unaffected.
PubkeyAuthentication yes
UsePAM yes
AuthorizedKeysCommand /usr/sbin/kanidm_ssh_authorizedkeys %u
AuthorizedKeysCommandUser nobody
