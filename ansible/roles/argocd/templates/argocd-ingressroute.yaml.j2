apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server-tls
  namespace: argocd
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ argocd_domain }}`)
      kind: Rule
      services:
        - name: argocd-server
          port: 80
  tls:
    secretName: {{ argocd_tls_secret_name }}
