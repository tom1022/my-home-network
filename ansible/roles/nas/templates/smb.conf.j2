# Managed by Ansible
[global]
   workgroup = WORKGROUP
   server role = standalone server
   security = user
   map to guest = never
   # Explicit although these match the Samba 4.17 defaults, so the policy is visible in config.
   server min protocol = SMB2_02
   ntlm auth = ntlmv2-only
   lanman auth = no
   # No printer or home shares.
   load printers = no
   disable spoolss = yes

[{{ nas_smb_share_name }}]
   path = {{ nas_smb_share_path }}
   # Kanidm members have no local owner of the share directory; act as the
   # share owner so NFS and SMB see the same ownership.
   force user = {{ nas_smb_user }}
   force group = {{ nas_smb_user }}
   guest ok = no
   read only = no
   browseable = no
   create mask = 0640
   directory mask = 0750
