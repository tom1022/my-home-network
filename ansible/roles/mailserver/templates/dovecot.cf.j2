{{ ansible_managed | comment }}
# docker-mailserver の公式な上書き経路 (/tmp/docker-mailserver/dovecot.cf →
# コンテナ内 /etc/dovecot/local.conf。dovecot.conf 末尾の !include_try local.conf で
# 読み込まれる)。既定の /etc/dovecot/conf.d/auth-ldap.conf.ext は user-patches.sh で
# 空に置き換えている (Kanidm に存在しない uniqueIdentifier/userPassword を参照する既定の
# fields ブロックが、ここに置く passdb ldap ブロックと同名でマージされ
# "ldap: unknown user" になるため)。
# submission の認証もこの passdb を経由する。

# noreply は LDAP より前に置き、result_failure = return-fail で誤パスワード時に LDAP へ
# 落とさない。落とすと 1 回の失敗で LDAP 側の失敗行も出て、fail2ban の dovecot フィルタが
# 2 回数える。passdb 名とファイルパスは docker-mailserver 標準のものと衝突させない。
passdb noreply {
  driver = passwd-file
  passwd_file_path = /etc/dovecot/noreply.passwd
  username_filter = {{ mailserver_noreply_address }}
  default_password_scheme = SHA512-CRYPT
  result_failure = return-fail
}

passdb ldap {
  ldap_uris = ldaps://{{ mailserver_kanidm_ldaps_host }}:{{ mailserver_kanidm_ldaps_port }}
  ldap_base = {{ mailserver_kanidm_base_dn }}
  # 検索で得た DN では bind しない。bind DN はテンプレートで組み立てる。
  bind = yes
  bind_userdn = spn=%{user},app={{ mailserver_kanidm_app_name }},{{ mailserver_kanidm_base_dn }}
  # bind 方式では値自体は評価されないが、Dovecot 2.4 は非空の値を要求する
  # (空だと "No passdb_ldap_filter given" で起動に失敗する。未文書化の制約)。
  passdb_ldap_filter = (spn=%{user})
}

# Nextcloud Mail が `<利用者>*mailmaster` でパスワードなしに利用者名義で接続するための
# master user。passdb 名のハイフンは、fail2ban の dovecot フィルタが passdb 名に
# [a-z\-]+ しか許さず、アンダースコアだと失敗行を拾わないため。
# import_environment が無いと %{env:MASTER_PASSWORD} が空に展開され照合に失敗する。
auth_master_user_separator = *
passdb master-static {
  driver = static
  master = yes
  username_filter = mailmaster
  passdb_static_password = {PLAIN}%{env:MASTER_PASSWORD}
}

import_environment {
  MASTER_PASSWORD = %{env:MASTER_PASSWORD}
}

# submission の認証結果 (成否) のみを用いる。VPS はメールボックスの実体を持たないため
# 静的な userdb は実際には参照されない。
userdb static {
  fields {
    uid = vmail
    gid = vmail
    home = /tmp/dovecot-unused/%{user}
  }
}
