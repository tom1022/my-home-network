# {{ ansible_managed }}
USER_EMAIL={{ beszel_hub_user_email }}
USER_PASSWORD={{ beszel_hub_user_password }}
# Cloudflare Access が付与する認証済みユーザーのメールアドレスヘッダーをそのまま
# 信頼する。このヘッダーはクライアント (ブラウザ) 側から偽装できず、到達制御も
# loopback bind + cloudflared トンネル経由限定で成立済み。
TRUSTED_AUTH_HEADER=Cf-Access-Authenticated-User-Email
USER_CREATION=true
# beszel_systems の各レコードは超級管理者 (USER_EMAIL) の所有として作成される。
# TRUSTED_AUTH_HEADER でログインする運用者アカウント (beszel_hub_trusted_user_email)
# は別ユーザーのため、SHARE_ALL_SYSTEMS が無いと HasUser() が false を返し
# 「No systems found」になる (henrygd/beszel internal/hub/systems/system.go)。
# 運用者は 1 名のみで複数ユーザー間の隔離は不要なため、全システムを共有する。
SHARE_ALL_SYSTEMS=true
